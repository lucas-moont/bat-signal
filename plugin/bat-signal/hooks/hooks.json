{
  "description": "Bat-Signal: report session activity to the Bat-Signal desktop app on 127.0.0.1:47777. Observe-only: each hook posts the event in the background and discards the reply, so whatever answers on that port can never take a decision, block a turn or add context. If the app isn't running, the post fails within a second and nothing changes for Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe -s -m 1 -o NUL -H \"Content-Type: application/json\" --data-binary '@-' http://127.0.0.1:47777/hook; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe -s -m 1 -o NUL -H \"Content-Type: application/json\" --data-binary '@-' http://127.0.0.1:47777/hook; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe -s -m 1 -o NUL -H \"Content-Type: application/json\" --data-binary '@-' http://127.0.0.1:47777/hook; exit 0",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
