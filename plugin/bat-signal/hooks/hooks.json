{
  "description": "Bat-Signal: report session activity to the Bat-Signal desktop app on 127.0.0.1:47777. Observe-only: each hook runs curl directly (no shell, so the same hook works on Windows, Linux and macOS) in the background, and writes the reply to a file in the plugin's data folder that nothing reads, so whatever answers on that port can never take a decision, block a turn or add context. If the app isn't running, the post fails within a second and nothing changes for Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": ["-s", "-m", "1", "--create-dirs", "-o", "${CLAUDE_PLUGIN_DATA}/reply", "-H", "Content-Type: application/json", "--data-binary", "@-", "http://127.0.0.1:47777/hook"],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": ["-s", "-m", "1", "--create-dirs", "-o", "${CLAUDE_PLUGIN_DATA}/reply", "-H", "Content-Type: application/json", "--data-binary", "@-", "http://127.0.0.1:47777/hook"],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": ["-s", "-m", "1", "--create-dirs", "-o", "${CLAUDE_PLUGIN_DATA}/reply", "-H", "Content-Type: application/json", "--data-binary", "@-", "http://127.0.0.1:47777/hook"],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": ["-s", "-m", "1", "--create-dirs", "-o", "${CLAUDE_PLUGIN_DATA}/reply", "-H", "Content-Type: application/json", "--data-binary", "@-", "http://127.0.0.1:47777/hook"],
