{
  "name": "bat-signal",
  "productName": "Bat-Signal",
  "version": "1.3.0",
  "description": "A tiny always-on-top window that watches your Claude Code sessions.",
  "author": "Lucas Monteiro",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "privacy": "node scripts/privacy.mts",
    "icons": "node scripts/icons.mts",
    "screenshot": "electron-vite build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/screenshot.ps1",
    "shots": "electron-vite build && electron scripts/shots.cjs",
    "gif": "electron-vite build && electron scripts/gif.cjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/big-shoulders-stencil": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/federo": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/marcellus-sc": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "motion": "^14.0.0",
    "prettier": "^3.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.lucasmoont.bat-signal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "../NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "node_modules/@fontsource/anton/LICENSE",
        "to": "licenses/Anton.txt"
      },
      {
        "from": "node_modules/@fontsource/archivo/LICENSE",
        "to": "licenses/Archivo.txt"
      },
      {
        "from": "node_modules/@fontsource/bangers/LICENSE",
        "to": "licenses/Bangers.txt"
      },
      {
        "from": "node_modules/@fontsource/barlow-semi-condensed/LICENSE",
        "to": "licenses/Barlow Semi Condensed.txt"
      },
      {
        "from": "node_modules/@fontsource/big-shoulders-stencil/LICENSE",
        "to": "licenses/Big Shoulders Stencil.txt"
      },
      {
        "from": "node_modules/@fontsource/bungee/LICENSE",
        "to": "licenses/Bungee.txt"
      },
      {
        "from": "node_modules/@fontsource/federo/LICENSE",
        "to": "licenses/Federo.txt"
      },
      {
        "from": "node_modules/@fontsource/grenze-gotisch/LICENSE",
        "to": "licenses/Grenze Gotisch.txt"
      },
      {
        "from": "node_modules/@fontsource/jetbrains-mono/LICENSE",
        "to": "licenses/JetBrains Mono.txt"
      },
      {
        "from": "node_modules/@fontsource/josefin-sans/LICENSE",
        "to": "licenses/Josefin Sans.txt"
      },
      {
        "from": "node_modules/@fontsource/limelight/LICENSE",
        "to": "licenses/Limelight.txt"
      },
      {
        "from": "node_modules/@fontsource/marcellus-sc/LICENSE",
        "to": "licenses/Marcellus SC.txt"
      },
      {
        "from": "node_modules/@fontsource/neucha/LICENSE",
        "to": "licenses/Neucha.txt"
      },
      {
        "from": "node_modules/@fontsource/oxanium/LICENSE",
        "to": "licenses/Oxanium.txt"
      },
      {
        "from": "node_modules/@fontsource/permanent-marker/LICENSE",
        "to": "licenses/Permanent Marker.txt"
      },
      {
        "from": "node_modules/@fontsource/shantell-sans/LICENSE",
        "to": "licenses/Shantell Sans.txt"
      },
      {
        "from": "node_modules/@fontsource/special-elite/LICENSE",
        "to": "licenses/Special Elite.txt"
      },
      {
        "from": "node_modules/@fontsource/syncopate/LICENSE",
        "to": "licenses/Syncopate.txt"
      }
    ],
    "win": {
      "icon": "resources/icons/tray.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "createDesktopShortcut": false
    },
    "linux": {
      "icon": "resources/icons/app.png",
      "executableName": "bat-signal",
      "category": "Utility",
      "synopsis": "Watches your Claude Code sessions from a corner of the screen",
      "target": [
        "AppImage"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "bat-signal"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
