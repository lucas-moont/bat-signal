{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  // The fixtures renderer tests share; the others (lines.ts) read main-process code.
  "include": [
    "src/renderer/src/**/*",
    "src/preload/*.ts",
    "src/shared/**/*",
    "test/renderer/**/*",
    "test/fixtures/hiddenPage.ts",
    "test/fixtures/themes.ts",
    "test/fixtures/words.ts"
  ]
}
